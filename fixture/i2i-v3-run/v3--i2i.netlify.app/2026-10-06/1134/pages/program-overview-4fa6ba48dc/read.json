      "durationMs": 1277,
      "offsetMs": 68985
    },
    {
      "n": 55,
      "command": "nextLine",
      "spoken": "i 2i welcomes cohort members, including, local organizations interested in funding from the state of",
      "durationMs": 1277,
      "offsetMs": 70262
    },
    {
      "n": 56,
      "command": "nextLine",
      "spoken": "Illinois and current grantees facing capacity constraints., Our commitment lies in fostering an",
      "durationMs": 1281,
      "offsetMs": 71543
    },
    {
      "n": 57,
      "command": "nextLine",
      "spoken": "inclusive environment, ensuring that organizations at various stages of development benefit from",
      "durationMs": 1277,
      "offsetMs": 72821
    },
    {
      "n": 58,
      "command": "nextLine",
      "spoken": "our expertise. Drawing from the wisdom of the National Council of Nonprofits,, we define nonprofit",
      "durationMs": 1280,
      "offsetMs": 74100
    },
    {
      "n": 59,
      "command": "nextLine",
